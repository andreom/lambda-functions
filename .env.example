# ========================================
# AWS Lambda Environment Variables
# ========================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no repositório
# ========================================

# ========================================
# S3 Copy Fail Email Function
# ========================================

# Buckets S3
SOURCE_BUCKET=ferj-prod-snowflake-relatorio
DESTINATION_BUCKET=ferj-prod-integracao
DESTINATION_PREFIX=voxis/VIEWS_VOXIS_SAUDI_UNIMED_FERJ_SCHEMA

# Email Configuration (AWS SES)
EMAIL_SOURCE=no-reply@domain.com.br
EMAIL_DESTINATION=admin@domain.com.br

# ========================================
# CSV to SOAP Webservice Function
# ========================================

# Webservice Configuration
WS_URL=https://exemplo.domain.com.br/webservice/transmiteArquivoService
WS_LOGIN=usuario_webservice
WS_PASSWORD=senha_webservice
CLIENT_CODE=codigo_cliente
SERVICE_ID=BNFC

# File Processing
FILE_TYPE=CSV

# Email Configuration (AWS SES)
EMAIL_SENDER=no-reply@empresa.com.br
EMAIL_RECIPIENTS=admin@empresa.com.br,equipe@empresa.com.br
EMAIL_CC=supervisor@empresa.com.br

# Optional: File Management
MOVE_PROCESSED=true
PROCESSED_PATH=processados/
DELETE_ORIGINAL=true
MOVE_FAILED=true
ERROR_PATH=erros/

# Optional: Connection Settings
VERIFY_SSL=1
WS_TIMEOUT=550

# ========================================
# AWS Configuration (for local testing)
# ========================================
# Note: These are not needed in Lambda, only for local testing

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
